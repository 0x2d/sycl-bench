def create_linear_range(begin, end, numsteps):
  stepsize = (end-begin) // numsteps
  if stepsize == 0:
    stepsize = 1
    
  return [begin+i*stepsize for i in range(0,numsteps)]

def create_log_range(begin, end):
  result = [begin]
  current = begin
  while current < end:
    current *= 2
    result += [current]
    
  return result


