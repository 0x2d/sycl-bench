# Scale every --size by SIZE_SCALE. Raw powers of two scaled by a
# non-power-of-two factor (e.g. 1024 -> 1228 at 1.2x) would break the
# runner's size % localsize == 0 launch contract below, so sizes are
# rounded up to a multiple of the local size (256). Benchmarks listed
# in UNSCALED_BENCHMARKS keep their original suite size. Applied to
# default_profile before construct_profile deep-copies it, so every
# profile inherits the scaled sizes.
#
# ORIGINAL_SIZES maps each scaled size back to its pre-scale value so
# the command echo below shows the unscaled --size; the benchmark still
# executes with the scaled size from the profile.
SIZE_SCALE = 2
LOCAL_SIZE_MULTIPLE = 256
UNSCALED_BENCHMARKS = { '2mm', '3mm', 'gemm'}
ORIGINAL_SIZES = {}

def scale_sizes(sizes):
  scaled = [((int(s * SIZE_SCALE) + LOCAL_SIZE_MULTIPLE - 1)
             // LOCAL_SIZE_MULTIPLE) * LOCAL_SIZE_MULTIPLE for s in sizes]
  for original, s in zip(sizes, scaled):
    ORIGINAL_SIZES[s] = original
  return scaled

default_profile['default-options']['--size'] = \
    scale_sizes(default_profile['default-options']['--size'])
for _name, _opts in default_profile['individual-benchmark-options'].items():
  if '--size' in _opts and _name not in UNSCALED_BENCHMARKS:
    _opts['--size'] = scale_sizes(_opts['--size'])

def construct_profile(overridden_options_dict,
                      additional_flags=[],
                      max_allowed_runtime=default_profile['max-allowed-runtime']):

  new_profile = copy.deepcopy(default_profile)
  new_profile['max-allowed-runtime'] = max_allowed_runtime
  for opt in overridden_options_dict:
    new_profile['default-options'][opt] = overridden_options_dict[opt]
  
  for f in additional_flags:
    new_profile['default-flags'].add(f)
  
  return new_profile

